__pycache__/
*.py[cod]
.venv/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store

# Generated datasets are regenerated from (config, seed); never committed.
# Anchored to the repo root so it cannot swallow src/prdbench/data/ or configs/data/.
/data/
/datasets/
*.npz
*.npy
*.h5

# Run outputs: results.json and figures are committed per experiment,
# raw checkpoints are not.
results/**/checkpoints/
*.pt
*.ckpt

# Scratch run outputs; keep reported runs under experiments/
results/
